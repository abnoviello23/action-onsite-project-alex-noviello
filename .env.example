# Copy .env-demo (keys only) or this file to .env before `docker compose up`.
# Never commit a filled .env — .gitignore covers it.

# --- Postgres ---
POSTGRES_USER=pkg
POSTGRES_PASSWORD=pkg_local_dev
POSTGRES_DB=pkg
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host-side port. Non-standard to avoid clashing with a local Postgres install.
POSTGRES_HOST_PORT=55432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=56379

# --- Topology ---
# Read by BOTH the poller (computes p = hash(source+entity_id) % NUM_PARTITIONS
# at enqueue time) and the workers (each consumes exactly one partition stream).
# These MUST agree, and there must be one worker service per partition, or a
# partition stream fills and is never drained.
NUM_PARTITIONS=2

# --- API ---
API_HOST_PORT=8000

# --- Embed (BGE-small) ---
# Host-side port for the chunker. Containers use http://embed:8080.
EMBED_HOST_PORT=18080

# --- Logging ---
LOG_LEVEL=INFO

# --- Slack ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_POLL_INTERVAL_SECONDS=30
SLACK_INCLUDE_PRIVATE=true
# Seeding posts as this bot. Channel create needs channels:manage (public) and
# groups:write (private); messages need chat:write. Re-runs are idempotent.

# --- Notion (unused until the connector is implemented) ---
# Internal integration secret (ntn_...). Capabilities are set in the Notion UI:
# read content, plus read user information *including email addresses* — email is
# the only key that joins a Notion person to the same human in Slack and Drive.
# Add insert content only if this token is also used for seeding.
NOTION_TOKEN=
# Pinned. 2025-09-03 split databases into data sources, 2026-02-01 halved the
# default page size, 2026-03-11 renamed archived to in_trash.
NOTION_VERSION=2026-03-11
NOTION_POLL_INTERVAL_SECONDS=60
# Every Nth cycle enumerates everything rather than sweeping by watermark. It is
# the only way deletions are detected — Notion reports neither a trash event nor
# a disconnection.
NOTION_RECONCILE_EVERY=10
# A page a human created and connected to the integration. Seeding only.
NOTION_ROOT_PAGE_ID=

# --- Google Drive ---
# Host path to the service account JSON key; mounted read-only into the poller
# at /run/secrets/drive-sa.json. Keep it outside this directory if the project
# lives in a synced folder — the file is a private key with no second factor.
DRIVE_KEY_FILE=./docker/no-drive-key.json
# Shared drive ids, comma-separated. Take each from its Drive URL:
# drive.google.com/drive/folders/<THIS>. The service account must be a member of
# every drive listed, or it sees nothing and reports no error.
# Leave empty to disable the Drive connector entirely.
DRIVE_IDS=
DRIVE_POLL_INTERVAL_SECONDS=30

# --- Agent (API service only) ---
# The retrieval agent. Leave the key empty to run the stack without it: the API
# still serves /health and the operator canvas, and /agent/query answers 503.
ANTHROPIC_API_KEY=
# Overridable. claude-opus-5 is the more capable option at higher cost.
ANTHROPIC_MODEL=claude-sonnet-5
# Thinking depth / token spend: low | medium | high | xhigh | max. Empty leaves
# the API default (high). Sampling parameters do not exist on current models —
# temperature and top_p are rejected — so this is the only such knob.
ANTHROPIC_EFFORT=

# Identities the X-Demo-Identity header may assume, comma-separated. This is a
# "become anyone" switch, so it is an explicit allowlist and empty disables the
# header entirely. Stand-in until OAuth-proven app-user links exist; the
# visibility kernel does not care how the seed identity was proven.
#   AGENT_DEMO_IDENTITIES=slack:user:U_ALICE,slack:user:U_CONTRACTOR
#
# An app user — one person across every source — is made with:
#   docker compose --profile admin run --rm identity link --email alice@acme.com
# which mints `app:user:alice@acme.com` as a member of every mirrored identity
# sharing that address. List it here to query as it.
AGENT_DEMO_IDENTITIES=

# Orchestrator budget. Parallel tool calls inside one turn count as one turn.
#
# Sized for acting rather than for asking. A plain question is usually answered
# in five or six, but a request to *do* something is two jobs out of one budget —
# working out the answer and working out where it goes — and the second is the
# one that gets squeezed. Eight turns was enough to produce a good summary and
# then run out before finding anywhere to put it. Lower it if this instance only
# ever answers questions; ACTIONS_ENABLED is what makes the difference.
AGENT_MAX_TURNS=14
AGENT_MAX_WALKERS=4
# Nodes opened in full per request, orchestrator and walkers together.
AGENT_MAX_NODES=60

# --- Semantic layer (ingest workers + semantic service) ---
# Extraction turns each ingested document into inferred entities (person, task,
# project) and the relations between them. Off by default: it spends a model
# call per document, so it is opt-in rather than something `compose up` starts
# billing for. Read on both sides — the ingest workers use it to decide whether
# to raise a job, the semantic service to decide whether to consume one — so
# turning it off stops the queue filling as well as draining.
SEMANTIC_ENABLED=false
# Extraction is a narrow, well-specified task against one document, so it does
# not need the retrieval model's depth. Effort is deliberately low.
SEMANTIC_MODEL=claude-sonnet-5
SEMANTIC_EFFORT=low
# Concurrent extractions. Bounded by the Anthropic rate limit, not by Postgres.
SEMANTIC_CONCURRENCY=4
# Tool-loop turns per document. The extractor names entities, sees what the
# graph already knows about them, records facts, and draws links between them,
# so it needs more than one round — but a document not finished in this many is
# looping rather than working.
SEMANTIC_MAX_TURNS=8

# Extraction can run against OpenAI instead of Anthropic. This is a shim for
# evaluating the extraction loop without an Anthropic key — not a second
# supported backend; the retrieval agent always uses Anthropic. Leave as
# 'anthropic' unless you are testing.
SEMANTIC_PROVIDER=anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Actions (API service only) ---
# Writing back to Slack, Drive, and Notion. Off by default: reading a mirrored
# graph is safe and posting to a real channel is not, so it is a deliberate
# switch rather than a default. Uses the same credentials as the seeder, and
# needs the same write scopes (chat:write, drive, Notion insert capability).
# A caller may only act on a node it can already see, and every attempt is
# recorded in action_invocation.
ACTIONS_ENABLED=false
